@implements IDisposable
@inject LoginState LoginState
@inject NavigationManager Navigation

<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">

        <NavLink class="navbar-brand" href="/">
            ClothingClub
        </NavLink>

        <button class="navbar-toggler"
                type="button"
                @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="@NavMenuCssClass navbar-collapse">

            <div class="navbar-nav ms-auto align-items-lg-center gap-3">

                @if (LoginState.IsLoggedIn)
                {
                    <NavLink class="nav-link" href="/annoncer">
                        Annoncer
                    </NavLink>

                    <NavLink class="nav-link" href="/minside">
                        Min side
                    </NavLink>

                    <button class="btn login-button" @onclick="Logout">
                        Log ud
                    </button>
                }

            </div>
        </div>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;

    private string NavMenuCssClass =>
        collapseNavMenu ? "collapse" : "show";

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void Logout()
    {
        LoginState.Logout();
        Navigation.NavigateTo("/");
    }
    
    
    protected override void OnInitialized()
    {
        // NavMenu lytter efter ændringer i loginstatus
        LoginState.OnChange += UpdateMenu;
    }

    private void UpdateMenu()
    {
        // Opdaterer navbaren, når loginstatus ændres
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Stopper med at lytte, når NavMenu fjernes
        LoginState.OnChange -= UpdateMenu;
    }


}