@page "/"
@page "/Login"
@using System.Net.Http.Json
@using Core
@inject LoginState LoginState
@inject NavigationManager Navigation
@inject HttpClient Http



<div class="auth-container">

    <!--Logind-->
    <div class="auth-box">

        <h2>Log ind</h2>
        <p>Velkommen tilbage til EaaaShare!</p>

        <div class="form-group">
            <label for="login-email">E-mail</label>
            <input id="login-email"
                   type="email"
                   class="form-control"
                   placeholder="Indtast din e-mail"
                   @bind="LoginEmail" /> <!--gemmer den værdi som brugeren skriver i feltet og binder den til LoginEmail variablen-->
        </div>

        <div class="form-group">
            <label for="login-password">Adgangskode</label>
            <input id="login-password"
                   type="password"
                   class="form-control"
                   placeholder="Indtast din adgangskode"
                   @bind="LoginPassword" /> <!--gemmer den værdi brugeren skriver og binder den til LoginPassword variablen-->
        </div>

        <button class="auth-button" @onclick="ValidateLogin">
            Log ind
        </button>
        @if (!string.IsNullOrEmpty(LoginMessage)) //den som viser fejlbesked til brugeren hvis deres password eller mail er forkert
        {
            <p class="text-danger">@LoginMessage</p>
        }

    </div>

    <!-- Opret profil -->
    <div class="auth-box">

        <h2>Opret profil</h2>
        <p>Bliv en del af EaaaShare!</p>

        <div class="form-group">
            <label for="register-name">Navn</label>
            <input id="register-name"
                   type="text"
                   class="form-control"
                   placeholder="Indtast dit navn"
                   @bind="RegisterName" /> <!--binder værdien til RegisterName variablen-->
        </div>

        <div class="form-group">
            <label for="register-email">E-mail</label>
            <input id="register-email"
                   type="email"
                   class="form-control"
                   placeholder="Indtast din e-mail"
                   @bind="RegisterEmail" /> <!--binder værdien til RegisterEmail variablen-->
        </div>
        
        <div class="form-group">
            <label for="register-email">E-mail</label>
            <input id="register-email"
                   type="email"
                   class="form-control"
                   placeholder="Indtast din e-mail"
                   @bind="RegisterPhonenumber" /> <!--binder værdien til RegisterPhonenumber variablen-->
        </div>

        <div class="form-group">
            <label for="register-password">Adgangskode</label>
            <input id="register-password"
                   type="password"
                   class="form-control"
                   placeholder="Opret en adgangskode"
                   @bind="RegisterPassword" /> <!--binder værdien til RegisterPassword variablen-->
        </div>

        <button class="auth-button" @onclick="CreateProfile"> <!--når knappen trykkes bliver man opretteti systemet, fordi CreateProfile kaldes-->
            Opret profil
        </button>

    </div>

</div>

@code {

    //Adressen på backenden
    const string apiUrl = "http://localhost:5125";

    //Login - udfyldes i formualen
    private string LoginEmail = "";
    private string LoginPassword = "";

    //Til at give fejlbesked ved logind
    public string LoginMessage = "";

    //Opret profil - udfyldes i formularen
    private string RegisterName = "";
    private string RegisterEmail = "";
    private string RegisterPhonenumber = "";
    private string RegisterPassword = "";
    
    
    //validere de login oplysninger vi har fået
    private async Task ValidateLogin()
    {
        //Opretter en Dictionary med den e-mail og adgangskode, som brugeren har indtastet i loginformularen
        var data = new Dictionary<string, string>
        {
            { "Email", LoginEmail }, { "Password", LoginPassword }
        };

        //Sender loginoplysningerne til backend med en HTTP POST-request
        //FormUrlEncodedContent gør oplysningerne klar til at blive sendt som formulardata - vi har gjort klar til modtagelsen i controlleren
        var response = await Http.PostAsync(
            $"{apiUrl}/Member/login", new FormUrlEncodedContent(data));

        //Kontrollerer om backend har godkendt login
        if (response.IsSuccessStatusCode)
        {
            //Henter det eksisterende Member_Id fra backend
            int memberId = await response.Content.ReadFromJsonAsync<int>();

            //Gemmer brugerens ID og loginstatus
            LoginState.SetLogin(memberId);
            // Sender brugeren videre til annoncesiden
            Navigation.NavigateTo("/annoncer");
        }
        else // ellers får brugeren en fejlbesked
        {
            LoginMessage = "Forkert e-mail eller adgangskode";
        }
    }

   
    
    //Gemmer det nyeoprettede medlem
    private async Task CreateProfile()
    {
        // Opretter et nyt Member-objekt med de oplysninger, brugeren har indtastet i formularen
        Member newMember = new Member
        {
            Name = RegisterName,
            Email = RegisterEmail,
            Password = RegisterPassword
        };

        //Sender den nye profil til backend
        // PostAsJsonAsync omdanner objektet til JSON, som backend kan modtage
        var response = await Http.PostAsJsonAsync($"{apiUrl}/Member", newMember);

        //Kontrollerer om backend har godkendt oprettelsen af profilen
        if (response.IsSuccessStatusCode)
        {
            //Rydder formularen efter oprettelse
            RegisterName = "";
            RegisterEmail = "";
            RegisterPassword = "";
        }
    }
}